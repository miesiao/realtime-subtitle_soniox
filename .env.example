SONIOX_API_KEY=
PORT=8787

# Password the host must send (via x-host-secret header) to fetch a Soniox
# temporary key and start recording. Required in production — the server
# refuses to issue temporary keys if this is unset. Pick your own value,
# never commit the real one.
HOST_SECRET=

# Railway Postgres connection string (SPEC §6.5). Railway provides two:
# DATABASE_URL is only reachable from inside Railway's private network (use
# this when deployed there); DATABASE_PUBLIC_URL works from anywhere,
# including local dev, via Railway's TCP proxy. The app prefers DATABASE_URL
# and falls back to DATABASE_PUBLIC_URL if that's unset — set whichever one
# applies to where you're running from. Never commit real values.
DATABASE_URL=
DATABASE_PUBLIC_URL=
# Set to "disable" only if connecting to a local non-SSL Postgres.
PGSSL=

# Used for the post-session transcript cleanup pipeline (SPEC §6.5/§6): once
# a session ends, its transcript lines are sent here to be turned into a
# readable cleaned transcript.
ANTHROPIC_API_KEY=
