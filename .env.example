SONIOX_API_KEY=
PORT=8787

# Password the host must send (via x-host-secret header) to fetch a Soniox
# temporary key and start recording. Required in production — the server
# refuses to issue temporary keys if this is unset. Pick your own value,
# never commit the real one.
HOST_SECRET=

# Railway Postgres connection string (SPEC §6.5). Railway provides two:
# DATABASE_URL is only reachable from inside Railway's private network (use
# this when deployed there); DATABASE_PUBLIC_URL works from anywhere,
# including local dev, via Railway's TCP proxy. The app prefers DATABASE_URL
# and falls back to DATABASE_PUBLIC_URL if that's unset — set whichever one
# applies to where you're running from. Never commit real values.
DATABASE_URL=
DATABASE_PUBLIC_URL=
# Set to "disable" only if connecting to a local non-SSL Postgres.
PGSSL=

# Used for the post-session transcript cleanup pipeline (SPEC §6.5/§6): once
# a session ends, its transcript lines are sent here to be turned into a
# readable cleaned transcript.
ANTHROPIC_API_KEY=

# Phase 3a: Google login (Passport). Create an OAuth 2.0 Client ID in Google
# Cloud Console with authorized redirect URI
# "<your origin>/auth/google/callback" and put its values here — never
# commit the real ones. (Reuse the same values already set in Railway.)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Signs the login session cookie (express-session). Any long random string;
# rotating it logs everyone out. Required in production — without it a
# random value is generated at boot, so logins won't survive a restart.
SESSION_SECRET=

# Application-layer authorization on top of Google OAuth: only these emails
# may log in as a host. Comma-separated, case/whitespace-insensitive.
# SECURITY: empty/unset blocks EVERYONE (fail-closed) — this is not "leave
# blank to allow all". Set it before anyone needs to log in.
LOGIN_ALLOWLIST=

# Set to "production" on Railway so the login cookie is marked Secure
# (HTTPS-only). Leave unset for local http:// development.
NODE_ENV=
